# Java project files (TP1, TP2, TP3 Spring)
/src/
/target/
/pom.xml
/README.md
/TP3/
/.github/
/.vscode/

# Python virtual environments
.venv/
venv/
ENV/
env/

# Python cache and compiled bytecode
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd

# OS metadata
.DS_Store
**/.DS_Store

# Large datasets (CIFAR-10 etc.) - too large for GitHub
**/data/

# Large archive files
*.tar
*.tar.gz
*.zip

# Large model checkpoints (>50MB)
*.pt

# Output artifacts (generated at runtime)
**/outputs/*.png
**/outputs/app_log.txt
